	<queryString language="SQL">
		<![CDATA[SELECT exides.horastrabajadas.usuario,
	exides.horastrabajadas.fecha,
	exides.horastrabajadas.horas_trabajadas,
	exides.horastrabajadas.horas_extras,
	exides.vacaciones.horas_vacaciones,
	exides.vacaciones.horas_convertidas,
	exides.vacaciones.usuario
FROM exides.horastrabajadas
	LEFT JOIN exides.vacaciones ON 
	 exides.horastrabajadas.usuario = exides.vacaciones.usuario]]>
	</queryString>
