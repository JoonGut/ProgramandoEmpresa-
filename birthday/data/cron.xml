<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Definir el Cron Job para ejecutar comparacion_birthdays() diariamente -->
        <record id="cron_envio_cumpleaños" model="ir.cron">
            <field name="name">Enviar Email de Cumpleaños</field>
            <field name="model_id" ref="birthday.model_empleado_birthday"/>  <!-- CORREGIDO -->
            <field name="state">code</field>
            <field name="code">model.comparacion_birthdays()</field>
            <field name="user_id" ref="base.user_admin"/>  <!-- Asegúrate de que este usuario exista -->
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
